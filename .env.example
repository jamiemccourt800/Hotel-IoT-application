# GitLab Unleash Feature Flags Configuration

# API URL from GitLab Feature Flags "Configure" dialog
UNLEASH_URL=https://gitlab.comp.dkit.ie/api/v4/feature_flags/unleash/PROJECT_ID

# Instance ID from GitLab Feature Flags "Configure" dialog
UNLEASH_INSTANCE_ID=glfct-xxxxxxxxxxxxxxxxxxxxxxxx

# Application name (shared across all actuators)
UNLEASH_APP_NAME=actuator
