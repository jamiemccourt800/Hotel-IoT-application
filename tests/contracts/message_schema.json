{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IoT Message Contract",
  "type": "object",
  "required": ["measurement", "timestamp", "fields", "tags"],
  "properties": {
    "measurement": {"type": "string"},
    "timestamp": {"type": "number"},
    "fields": {"type": "object"},
    "tags": {
      "type": "object",
      "required": ["hotel_id", "room", "sensor"],
      "properties": {
        "hotel_id": {"type": "string"},
        "room": {"type": ["string", "integer"]},
        "sensor": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
