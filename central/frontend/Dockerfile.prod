FROM node:18-alpine AS build


WORKDIR /app

RUN apk add --no-cache python3 make g++

ENV REACT_APP_COMMAND_SERVICE_URL=http://api.prod.localhost/command
ENV REACT_APP_BOOKING_SERVICE_URL=http://api.prod.localhost/booking-api
ENV REACT_APP_GRAFANA_URL=http://frontend.prod.localhost/grafana

ENV PATH=/app/node_modules/.bin:$PATH

COPY package*.json ./
RUN npm install

COPY . .

RUN npm run build

# prod
FROM nginx:1.23-alpine

COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80


CMD ["nginx", "-g", "daemon off;"]