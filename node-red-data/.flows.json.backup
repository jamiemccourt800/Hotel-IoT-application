    {
        "id": "922ab89854b904e3",
        "type": "function",
        "z": "4585bb27a8572cf8",
        "name": "Parse Thermometer",
        "func": "let data = JSON.parse(msg.payload);\nmsg.payload = data.fields.temperature;\nreturn msg;",
