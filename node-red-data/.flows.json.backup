    {
        "id": "4e35b57ad96cf915",
        "type": "function",
        "z": "4585bb27a8572cf8",
        "name": "Parse Light",
        "func": "let data = JSON.parse(msg.payload);\nmsg.payload = data.fields.status ? \"ON\" : \"OFF\";\nreturn msg;",
