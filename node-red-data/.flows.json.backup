    {
        "id": "1d9523ad14cd7a7a",
        "type": "function",
        "z": "4585bb27a8572cf8",
        "name": "Wrap Temp JSON",
        "func": "msg.payload = { set: msg.payload };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 440,
